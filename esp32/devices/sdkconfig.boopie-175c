# Boopie's own settings for the Waveshare 1.75C, loaded last, after
# sdkconfig.muse-waveshare-s3-175c.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_boopie_32mb.csv"
# The last crash, kept in its own partition for debugging (docs/boopie-storage.md).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# The smooth Chinese font, drawn by LVGL's TinyTTF from the assets partition
# (font/boopie_font.c); a Chinese UI meets many glyphs, so more are cached.
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256
# Phone setup (ui/boopie_setup.c): QR codes on screen, and room for a phone's
# headers at the hotspot's web page.
CONFIG_LV_USE_QRCODE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# The page's server and DNS sit beside Muse's links; the proxy will want more.
CONFIG_LWIP_MAX_SOCKETS=16
# The VPN (vpn/boopie_vpn.c): Muse's names resolve to the board's relay, and
# Shadowsocks nodes may use ChaCha20-Poly1305.
CONFIG_LWIP_HOOK_NETCONN_EXT_RESOLVE_CUSTOM=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
